# 复制这个文件为 .env，再把下面的值换成你自己的真实配置
# .env 本身不要提交进 git（.gitignore 已经排除了它）

# ── 必填：至少要有这一个 Key，Agent 才能对话 ──────────────────
# 去 https://platform.deepseek.com 注册后获取
DEEPSEEK_API_KEY=sk-你申请到的真实key

# ── 必填（完整版）：RAG 简章问答功能需要 Embedding，走这个 Key ──
# 去 https://siliconflow.cn 注册后获取（有免费额度）；也可作为 Chat 备用轨道
SILICONFLOW_API_KEY=sk-你申请到的真实key

# ── 数据库密码：compose 里 ${DB_PASSWORD} 引用的就是它 ──────
# Mac 开发/服务器部署都从这里取值；服务器上务必改成 16 位以上强密码！
# 注意：postgres 数据卷首次初始化后密码就定死了，改这里不会改已有库的密码
DB_PASSWORD=填一个16位以上的强密码_不要用默认的planner123
# 网站访问密码（多访客隔离版新增）：
#   部署到公网必须设置——Streamlit 工作台会先要求输入这个密码，
#   防止陌生人打开你的网站消耗大模型 API 额度。
#   本地开发不想输密码的话，把这一行删掉或留空即可（不设防）。
SITE_ACCESS_PASSWORD=换成一个只发给测试者的密码

# ── 可选：不填就用下面这些默认值 ────────────────────────────
CHAT_PROVIDER=deepseek
EMBEDDING_PROVIDER=siliconflow
# 下面两条是"不用 Docker、直接在 Mac 上裸跑代码"时的本地连接地址；
# 跑在 Docker 容器里时，compose 的 environment 会用服务名地址覆盖它们
DATABASE_URL=postgresql://planner:planner123@localhost:5432/planner_copilot
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600
MAX_TOOL_CALL_ROUNDS=6

# ── 知识库 / RAG ─────────────────────────────────────────────
KNOWLEDGE_BASE_PATH=data/tianjin_programs.json
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.5

# ── FastAPI 多规划师鉴权 ─────────────────────────────────────
# 格式：key1:规划师ID1,key2:规划师ID2 —— 部署前务必换成自己的随机字符串
PLANNER_API_KEYS=planner-key-001:planner_001,planner-key-002:planner_002

# ── 批量处理 ────────────────────────────────────────────────
BATCH_MAX_CONCURRENT=5
CACHE_TTL_SECONDS=86400

# ── 可选：Langfuse 可观测性（追踪每次对话用了哪些工具/耗时/Token） ──
# 不填就完全不启用，Agent 照常工作，观测这部分静默跳过。
# 去 https://cloud.langfuse.com 注册后，在项目设置里找到这两个 Key。
# 装这个功能还需要额外执行：uv sync --extra observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 如果是自建的 Langfuse（而不是用云端版），把下面这行取消注释并改成你自己的地址
# LANGFUSE_HOST=https://your-self-hosted-langfuse.example.com




# 终端输入快速验证代码是否能跑
# DATABASE_URL=sqlite:///./test.db uv run pytest test_tools.py test_enrollment_bot.py
# 验证完后
# rm -f test.db

# 配置好环境后输入可测试项目：
# uv run python check_setup.py

# 查看是否可以启动项目
# uv run python app.py